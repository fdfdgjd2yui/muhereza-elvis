rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Strict single 'get' document read ONLY for student lookup by exact Index Number
    // Completely reject 'list' operations (collection search queries) to protect candidate privacy
    match /students/{studentId} {
      allow get: if true;
      allow list: if false;
      allow write: if true;
    }

    match /gallery/{galleryId} {
      allow read: if true;
      allow write: if true;
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if true;
    }

    match /news/{newsId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
